# ==============================================================================
# Progressive Credential Loading (PCL) Configuration
# Repository: model-regression-detection
# ==============================================================================
#
# TIER 1: ZERO-SETUP / LOCAL DEV / CI (Default)
# - No OpenAI API key required.
# - System runs in Mock Mode using deterministic scoring and mock target completions.
# - Database operates with embedded in-memory SQLite (sql.js).
#
# TIER 2: LOCAL DEV WITH LIVE AI
# - Supply an OpenAI API key (sk-...) to activate live GPT-4o-mini LLM-as-judge
#   evaluations for factual consistency, semantic similarity, and tone formatting.
#
# TIER 3: PRODUCTION KUBERNETES DEPLOYMENT
# - Inject credentials via Kubernetes Secrets or Helm values.
#
# ── AI Provider ──────────────────────────────────────────────────────────────
# UNSET or sk-dummy (default): Deterministic mock evaluation (CI-safe)
# SET to real sk-... key: Live GPT-4o-mini LLM-as-judge evaluation
OPENAI_API_KEY=

# ── Port ─────────────────────────────────────────────────────────────────────
PORT=3000
